# Copy to .env (gitignored). Never commit real keys.
# Only needed for the optional real-LLM agent in the lab.
LLM_API_KEY=
# The model the lab agent uses. Pick one from your account; there is no default.
HC_LLM_MODEL=
# Only if your provider is not api.anthropic.com. It must speak the Anthropic Messages format.
# A base that already ends in /v1 is fine.
HC_LLM_BASE_URL=

# Incident email (used from M2). Never commit real values.
SMTP_HOST=
SMTP_PORT=587
# starttls (default), ssl, or none (only for local tests)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
